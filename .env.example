# Copie este arquivo para .env e preencha apenas com uma API key Helius.
# Nunca use uma chave privada ou frase-semente aqui.
HELIUS_API_KEY=replace_with_your_helius_api_key

# mainnet ou devnet
SOLANA_CLUSTER=mainnet

# A rede permanece bloqueada até uma autorização explícita.
# Verifique os limites e possíveis custos do seu plano Helius antes de habilitar.
SMR_ALLOW_NETWORK=false

# Caminho opcional para o histórico local (SQLite).
# SMR_DB_PATH=data/smr_history.sqlite3